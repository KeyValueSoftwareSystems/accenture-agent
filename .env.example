# OpenAI
OPENAI_API_KEY=sk-...
MODEL=gpt-4o-mini

# Netra observability (demo environment)
NETRA_OTLP_ENDPOINT=https://api.demo.getnetra.ai/telemetry
NETRA_API_KEY=

# Optional: point the frontend at a specific backend origin instead of the
# bundled proxy. Leave empty to use same-origin /chat (nginx in Docker, Vite in
# dev). When set, the backend must allow this origin via CORS_ORIGINS.
# VITE_BACKEND_URL=http://localhost:8000

# CORS origins allowed by the backend (JSON array). Default: ["*"]
# CORS_ORIGINS=["http://localhost:5173"]